# Copie para .env e preencha com valores reais. Nunca versione o .env.

# URL pública do site (metadata, sitemap, canonical, Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# URL canônica para NextAuth (use HTTPS em produção)
NEXTAUTH_URL=http://localhost:3000

# PostgreSQL — obrigatório para catálogo e admin
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public

# Secret para assinar sessões JWT (mínimo 32 caracteres aleatórios)
NEXTAUTH_SECRET=

# Subdiretório em data/ para imagens locais (somente desenvolvimento)
PRODUCT_IMAGE_STORAGE_DIR=product-images
